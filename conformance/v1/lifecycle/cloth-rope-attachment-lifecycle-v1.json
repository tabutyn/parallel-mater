{
  "schema": "parallel-mater-conformance-lifecycle-profile/v1",
  "id": "cloth-rope-attachment-lifecycle-v1",
  "title": "Cloth-rope attachment graph bounded lifecycle",
  "sources": {
    "capacity": "include/parallel_mater/parallel_mater.h: PmSimulationCreateInfo::couplingCapacity and pmCmdSetCouplings",
    "qualification": "docs/ROADMAP.md: F5-41",
    "rollback": "docs/RESOURCE-LIFETIME.md: a rejected graph mutation preserves the last usable graph"
  },
  "state_fingerprint": "SHA-256 of the canonical accepted public cloth-rope ATTACHMENT descriptor plus public cloth and rope endpoint outputs; exclude handles, timings and driver-private state",
  "observation_boundary": "Complete each graph mutation and zero-gravity step before public readback; generation is the harness ordinal of an accepted graph mutation, never a private driver handle",
  "cases": [
    {
      "id": "cloth-rope-attachment-capacity-replacement-removal-rollback",
      "families": ["cloth", "rope"],
      "unrelated_resources": ["cloth-rope-endpoints"],
      "tracked_resources": ["cloth-rope-attachment-graph", "cloth-rope-endpoints"],
      "track_graph": false,
      "checkpoints": [
        {
          "id": "baseline",
          "expected_outcome": "PM_SUCCESS",
          "resources": {
            "cloth-rope-attachment-graph": {"active": true},
            "cloth-rope-endpoints": {"active": true}
          }
        },
        {
          "id": "replacement",
          "expected_outcome": "PM_SUCCESS",
          "resources": {
            "cloth-rope-attachment-graph": {"active": true, "generation_different_from": "baseline", "state_different_from": "baseline"},
            "cloth-rope-endpoints": {"active": true, "generation_same_as": "baseline", "state_same_as": "baseline"}
          }
        },
        {
          "id": "rejected-overflow",
          "expected_outcome": "PM_ERROR_CAPACITY_EXCEEDED",
          "resources": {
            "cloth-rope-attachment-graph": {"active": true, "generation_same_as": "replacement", "state_same_as": "replacement"},
            "cloth-rope-endpoints": {"active": true, "generation_same_as": "baseline", "state_same_as": "baseline"}
          }
        },
        {
          "id": "removal",
          "expected_outcome": "PM_SUCCESS",
          "resources": {
            "cloth-rope-attachment-graph": {"active": false, "generation_different_from": "replacement", "state_different_from": "replacement"},
            "cloth-rope-endpoints": {"active": true, "generation_same_as": "baseline", "state_same_as": "baseline"}
          }
        },
        {
          "id": "recovery",
          "expected_outcome": "PM_SUCCESS",
          "resources": {
            "cloth-rope-attachment-graph": {"active": true, "generation_different_from": "removal", "state_different_from": "removal"},
            "cloth-rope-endpoints": {"active": true, "generation_same_as": "baseline", "state_same_as": "baseline"}
          }
        }
      ]
    }
  ]
}
