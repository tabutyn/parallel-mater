  "semantic_assertions": {
    "cold-start":{"inputs":["first completed public state","first PmRealtimeStepStatistics"],"algorithm":"finite public state, exact tick zero-to-one advance and no unreported warm-up step"},
    "impact":{"inputs":["successive public positions","successive public velocities","PmContactEvent"],"algorithm":"swept approach is followed by finite separating response and no tunneling event"},
    "rotation":{"inputs":["successive public orientations or centerline directions"],"algorithm":"finite shortest-arc angular displacement has the authored sign and remains within the fixture bound"},
    "mass-ratio":{"inputs":["public endpoint velocities","authored masses"],"algorithm":"mass-weighted reciprocal impulse residual from public state remains within the named domain limits"},
    "stiff-system":{"inputs":["public constrained positions","authored rest geometry"],"algorithm":"maximum and RMS public constraint errors use the named domain measurements"},
    "long-run":{"inputs":["all completed public samples","public stable ids"],"algorithm":"final tick is reached with finite state, stable identity and no omitted sample"},
    "containment":{"inputs":["public positions","authored closed boundary"],"algorithm":"count stable ids outside the closed boundary using swept public state"},
    "source":{"inputs":["public stable ids before and after authored source event"],"algorithm":"new identities appear only after the public source event and in deterministic order"},
    "removal":{"inputs":["public stable ids before and after authored removal event"],"algorithm":"retired identities disappear only after the public removal event and never reappear"},
    "replacement":{"inputs":["public stable ids","public state hashes","authored replacement event"],"algorithm":"retired generation is absent and replacement state is observable after the atomic public boundary"},
    "overflow":{"inputs":["public result","public state and clock hashes","PmRealtimeStepStatistics"],"algorithm":"PM_ERROR_CAPACITY_EXCEEDED preserves state, clock and pending input with zero update, publication, advance or retry"},
    "recovery":{"inputs":["retained public input","next public result","public state and clock hashes"],"algorithm":"one later resubmission succeeds exactly once and advances the retained input"},
    "empty":{"inputs":["public resource counts","PmRealtimeStepStatistics"],"algorithm":"zero active resources complete one tick with finite empty output and exact work accounting"},
    "sparse":{"inputs":["public resource counts and stable ids","PmRealtimeStepStatistics"],"algorithm":"one resource per declared family completes one tick without capacity-sized phantom output"}
  },
