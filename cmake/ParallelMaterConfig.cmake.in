@PACKAGE_INIT@

set(ParallelMater_VERSION "@PROJECT_VERSION@")
set(ParallelMater_API_VERSION "0.3")
foreach(component IN ITEMS loader validation preparation scene driver
                           conformance benchmark)
    set(ParallelMater_${component}_FOUND FALSE)
endforeach()

set(_parallel_mater_loader_targets
    "${CMAKE_CURRENT_LIST_DIR}/ParallelMaterLoaderTargets.cmake")
if(EXISTS "${_parallel_mater_loader_targets}")
    include("${_parallel_mater_loader_targets}")
    set(ParallelMater_loader_FOUND TRUE)
    if(NOT TARGET ParallelMater::api)
        add_library(ParallelMater::api ALIAS ParallelMater::parallel_mater)
    endif()
endif()

set(_parallel_mater_validation_targets
    "${CMAKE_CURRENT_LIST_DIR}/ParallelMaterValidationTargets.cmake")
if(EXISTS "${_parallel_mater_validation_targets}")
    include("${_parallel_mater_validation_targets}")
    set(ParallelMater_validation_FOUND TRUE)
    if(NOT TARGET ParallelMater::validation)
        add_library(ParallelMater::validation ALIAS
            ParallelMater::parallel-mater-layer-validation)
    endif()
endif()

set(_parallel_mater_preparation_targets
    "${CMAKE_CURRENT_LIST_DIR}/ParallelMaterPreparationTargets.cmake")
if(EXISTS "${_parallel_mater_preparation_targets}")
    include("${_parallel_mater_preparation_targets}")
    set(ParallelMater_preparation_FOUND TRUE)
endif()

set(_parallel_mater_scene_targets
    "${CMAKE_CURRENT_LIST_DIR}/ParallelMaterSceneTargets.cmake")
if(EXISTS "${_parallel_mater_scene_targets}")
    if(NOT ParallelMater_loader_FOUND)
        set(ParallelMater_scene_NOT_FOUND_MESSAGE
            "The scene component requires the loader component")
    elseif(NOT ParallelMater_preparation_FOUND)
        set(ParallelMater_scene_NOT_FOUND_MESSAGE
            "The scene component requires the preparation component")
    else()
        include("${_parallel_mater_scene_targets}")
        set(ParallelMater_scene_FOUND TRUE)
    endif()
endif()

set(_parallel_mater_driver_targets
    "${CMAKE_CURRENT_LIST_DIR}/ParallelMaterDriverTargets.cmake")
if(EXISTS "${_parallel_mater_driver_targets}")
    include("${_parallel_mater_driver_targets}")
    set(ParallelMater_DRIVER_TARGETS)
    foreach(target IN ITEMS slang_cuda_driver slang_d3d12_driver
                            slang_vulkan_driver slang_cpu_driver
                            slang_metal_driver)
        if(TARGET ParallelMater::${target})
            list(APPEND ParallelMater_DRIVER_TARGETS ParallelMater::${target})
        endif()
    endforeach()
    if(ParallelMater_DRIVER_TARGETS)
        set(ParallelMater_driver_FOUND TRUE)
    endif()
endif()

set(_parallel_mater_conformance_component
    "${CMAKE_CURRENT_LIST_DIR}/ParallelMaterConformanceComponent.cmake")
if(EXISTS "${_parallel_mater_conformance_component}")
    include("${_parallel_mater_conformance_component}")
    if(NOT ParallelMater_loader_FOUND)
        set(ParallelMater_conformance_FOUND FALSE)
        set(ParallelMater_conformance_NOT_FOUND_MESSAGE
            "The conformance component requires the loader component")
    elseif(NOT EXISTS "${ParallelMater_CONFORMANCE_EXECUTABLE}")
        set(ParallelMater_conformance_FOUND FALSE)
        set(ParallelMater_conformance_NOT_FOUND_MESSAGE
            "The conformance executable is missing")
    endif()
endif()

set(_parallel_mater_benchmark_component
    "${CMAKE_CURRENT_LIST_DIR}/ParallelMaterBenchmarkComponent.cmake")
if(EXISTS "${_parallel_mater_benchmark_component}")
    include("${_parallel_mater_benchmark_component}")
    if(NOT EXISTS "${ParallelMater_BENCHMARK_QUALIFICATION}")
        set(ParallelMater_benchmark_FOUND FALSE)
        set(ParallelMater_benchmark_NOT_FOUND_MESSAGE
            "The benchmark qualification tool is missing")
    endif()
endif()

unset(_parallel_mater_loader_targets)
unset(_parallel_mater_validation_targets)
unset(_parallel_mater_preparation_targets)
unset(_parallel_mater_scene_targets)
unset(_parallel_mater_driver_targets)
unset(_parallel_mater_conformance_component)
unset(_parallel_mater_benchmark_component)
check_required_components(ParallelMater)
