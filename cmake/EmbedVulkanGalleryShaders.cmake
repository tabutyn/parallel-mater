file(WRITE "${OUTPUT_FILE}"
    "// Generated from common Gallery Slang. Do not edit.\n#pragma once\n#include <cstdint>\nnamespace parallel_mater::gallery::vulkan_shaders {\n")
foreach(shader vertex fragment overlay_vertex overlay_fragment)
    file(READ "${SHADER_DIR}/${shader}.spv" bytes HEX)
    # Slang 2026 emits OpSource with the newly assigned Slang source-language
    # operand. Older Vulkan SDK validation layers reject that debug-only
    # declaration before validating otherwise portable SPIR-V. Strip OpSource
    # while embedding; executable instructions and reflection stay unchanged.
    string(LENGTH "${bytes}" byte_count)
    if(byte_count LESS 40)
        message(FATAL_ERROR "${shader}.spv has no complete SPIR-V header")
    endif()
    string(SUBSTRING "${bytes}" 0 40 runtime_bytes)
    set(cursor 40)
    while(cursor LESS byte_count)
        math(EXPR remaining "${byte_count} - ${cursor}")
        if(remaining LESS 8)
            message(FATAL_ERROR "${shader}.spv has a truncated instruction")
        endif()
        string(SUBSTRING "${bytes}" ${cursor} 8 first_word)
        string(SUBSTRING "${first_word}" 0 2 opcode_low)
        string(SUBSTRING "${first_word}" 2 2 opcode_high)
        string(SUBSTRING "${first_word}" 4 2 count_low)
        string(SUBSTRING "${first_word}" 6 2 count_high)
        math(EXPR opcode "0x${opcode_high}${opcode_low}")
        math(EXPR word_count "0x${count_high}${count_low}")
        if(word_count LESS 1)
            message(FATAL_ERROR "${shader}.spv has a zero-length instruction")
        endif()
        math(EXPR instruction_size "${word_count} * 8")
        if(instruction_size GREATER remaining)
            message(FATAL_ERROR "${shader}.spv has an out-of-bounds instruction")
        endif()
        if(NOT opcode EQUAL 3)
            string(SUBSTRING "${bytes}" ${cursor} ${instruction_size} instruction)
            string(APPEND runtime_bytes "${instruction}")
        endif()
        math(EXPR cursor "${cursor} + ${instruction_size}")
    endwhile()
    set(bytes "${runtime_bytes}")
    string(REGEX REPLACE "(..)" "0x\\1," bytes "${bytes}")
    file(APPEND "${OUTPUT_FILE}"
        "alignas(4) inline constexpr std::uint8_t ${shader}[] = {${bytes}};\n")
endforeach()
file(APPEND "${OUTPUT_FILE}" "}\n")
