# Package relative shader paths; installed drivers never access the source tree.
file(STRINGS "${MANIFEST}" records)
set(manifest "")
foreach(record IN LISTS records)
    string(REPLACE "|" ";" parts "${record}")
    list(GET parts 0 module)
    list(GET parts 1 entry)
    list(GET parts 2 base)
    if(NOT module MATCHES "^(geometry|geometry_constraints|queries|primitives)$")
        continue()
    endif()
    file(MAKE_DIRECTORY "${DESTINATION}/${module}")
    foreach(extension json metallib)
        file(COPY_FILE "${base}.${extension}" "${DESTINATION}/${module}/${entry}.${extension}" ONLY_IF_DIFFERENT)
    endforeach()
    string(APPEND manifest "${module}|${entry}|${module}/${entry}\n")
endforeach()
file(WRITE "${DESTINATION}/manifest.txt" "${manifest}")
