    "previous_144_retained": true,
    "added": [
      "parallel-mater-cuda-completion-wait-plain",
      "parallel-mater-cuda-completion-wait-validation"
    ],
    "focused": "Extended submission-queue tests cover completion before blocking, expired deadline, simultaneous waiters and capture retirement. Public suites cover pending/ready, zero/finite/large/infinite timeout, any/all, foreign/null handles, simultaneous waiters, timeline ordering and reset. Existing async suite adds failed-timeline and ready-plus-failed-fence errors without removing prior checks."
  },
